---
import ContactForm from '../components/contact/ContactForm.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import Layout from '../layouts/Layout.astro';
import type { OpeningHoursRow } from '../lib/opening-hours';
import { loadQuery } from '../sanity/lib/load-query';

const OPENING_HOURS_QUERY = `*[_type == "cafeneaPage" && _id == "cafeneaPage"][0].openingHours[]{
	_key,
	label,
	value
}`;

const { data: openingHours } = await loadQuery<
	(OpeningHoursRow & { _key: string })[] | null
>({ query: OPENING_HOURS_QUERY });
---

<Layout
	title="Contact — Prăjitorie și cafenea Noima, Cluj"
	description="Scrie-ne sau treci pe la prăjitorie. Strada Bobâlnei 58, Cluj-Napoca. Telefon: +40 754 557 744 · hello@prajitorianoima.ro."
>
	<ContactHero />
	<ContactForm openingHours={openingHours ?? []} />
</Layout>
