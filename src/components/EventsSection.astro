---
import { Image } from 'astro:assets';
import EventBackground from '../assets/main/event-background.png';
import { formatEventDate } from '../lib/events';
import Button from './Button.astro';

interface EventItem {
	_id: string;
	title: string;
	slug: string;
	date: string;
	summary?: string;
}

interface Props {
	heading?: string;
	/** Target for both the in-panel calendar link and the archive button. */
	archiveHref?: string;
	events: EventItem[];
}

const {
	heading = 'comunitate',
	archiveHref = '/evenimente',
	events,
} = Astro.props;

/**
 * Both routes into the archive — the in-panel calendar link and the button
 * below the panel — are parked until there are enough past events to make the
 * archive worth opening. `/evenimente` itself stays live in the meantime.
 * Flip to `true` to bring both back.
 */
const SHOW_ARCHIVE_LINKS = false;

function truncate(text: string | undefined, max = 200) {
	if (!text) return '';
	const clean = text.replace(/\s+/g, ' ').trim();
	if (clean.length <= max) return clean;
	const slice = clean.slice(0, max);
	const lastSpace = slice.lastIndexOf(' ');
	return `${slice.slice(0, lastSpace > 80 ? lastSpace : max)}…`;
}
---

<section id="evenimente" class="events-section py-16 md:py-24">
	<div class="container-x">
		<h2 class="section-heading mb-8">{heading}</h2>
	</div>

	{
		events.length > 0 ? (
			<div class="container-x events-panel-wrap">
				<div
					class="events-panel min-h-[420px] p-5 md:min-h-[620px] md:px-20 md:py-16"
					data-events-carousel
					data-count={events.length}
				>
					<div class="events-bg" aria-hidden="true">
						<Image
							src={EventBackground}
							alt=""
							widths={[960, 1440, 1920, 2560, 3200]}
							sizes="(min-width: 1818px) 1818px, 100vw"
							quality={85}
							format="webp"
							class="events-bg-img"
						/>
						<div class="events-bg-overlay" />
					</div>

					{SHOW_ARCHIVE_LINKS && (
						<div class="events-panel-top">
							<a href={archiveHref} class="events-calendar-btn">
								<svg
									width="18"
									height="18"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<rect x="3" y="4" width="18" height="18" rx="2" />
									<path d="M16 2v4M8 2v4M3 10h18" />
								</svg>
								<span>Vezi calendarul cu evenimente</span>
							</a>
						</div>
					)}

					<div class="events-slides">
						{events.map((event, i) => (
							<article
								class="events-slide"
								data-slide-index={i}
								data-active={i === 0 ? 'true' : 'false'}
								aria-hidden={i === 0 ? 'false' : 'true'}
							>
								<p class="eyebrow events-slide-date">
									<time datetime={event.date}>{formatEventDate(event.date)}</time>
								</p>
								<h3
									class="display events-slide-title"
									transition:name={`event-title-${event.slug}`}
								>
									{event.title}
								</h3>
								{event.summary && (
									<p class="events-slide-text text-[0.9375rem] md:text-base">
										{truncate(event.summary, 220)}
									</p>
								)}
								<Button
									href={`/evenimente/${event.slug}`}
									variant="primary"
									class="events-slide-cta"
								>
									VEZI EVENIMENTUL
								</Button>
							</article>
						))}
					</div>

					{events.length > 1 && (
						<div class="events-controls">
							<button
								type="button"
								class="events-arrow events-arrow-prev"
								data-events-prev
								aria-label="Evenimentul anterior"
							>
								<svg
									width="14"
									height="14"
									viewBox="0 0 14 14"
									fill="currentColor"
									aria-hidden="true"
								>
									<path d="M14 0v14L0 7z" />
								</svg>
							</button>

							<div
								class="events-dots"
								role="tablist"
								aria-label="Selectează evenimentul"
							>
								{events.map((event, i) => (
									<button
										type="button"
										class="events-dot"
										data-events-dot={i}
										data-active={i === 0 ? 'true' : 'false'}
										role="tab"
										aria-selected={i === 0 ? 'true' : 'false'}
										aria-label={`Eveniment ${i + 1}: ${event.title}`}
									/>
								))}
							</div>

							<button
								type="button"
								class="events-arrow events-arrow-next"
								data-events-next
								aria-label="Evenimentul următor"
							>
								<svg
									width="14"
									height="14"
									viewBox="0 0 14 14"
									fill="currentColor"
									aria-hidden="true"
								>
									<path d="M0 0v14l14-7z" />
								</svg>
							</button>
						</div>
					)}
				</div>
			</div>
		) : (
			<div class="container-x">
				<p class="body-copy events-empty">
					Momentan nu avem evenimente programate.{' '}
					{SHOW_ARCHIVE_LINKS
						? 'Aruncă o privire peste ce am organizat până acum.'
						: 'Revino curând — pregătim următoarele întâlniri.'}
				</p>
			</div>
		)
	}

	{
		SHOW_ARCHIVE_LINKS && (
			<div class="container-x events-archive-cta">
				<Button href={archiveHref} variant="dark">
					ARHIVA EVENIMENTE
				</Button>
			</div>
		)
	}
</section>

<style>
	.events-panel {
		position: relative;
		overflow: hidden;
		border-radius: 4px;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		color: #fff;
		isolation: isolate;
	}

	.events-bg {
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	.events-bg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Bottom-weighted scrim on mobile, where the copy spans the full width.
	   Desktop adds a left-hand wash so the text column keeps its contrast over
	   the bright part of the photo. */
	.events-bg-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 0.35) 0%,
			rgba(0, 0, 0, 0.5) 40%,
			rgba(0, 0, 0, 0.78) 100%
		);
	}

	/* Keeps the calendar link pinned to the top of a bottom-aligned panel
	   without absolute positioning, so a long title can never run under it. */
	.events-panel-top {
		display: flex;
		justify-content: center;
		margin-bottom: auto;
		padding-bottom: 2rem;
	}

	.events-calendar-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.85rem 1.5rem;
		font-size: 0.875rem;
		letter-spacing: 0.02em;
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.7);
		background: transparent;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 0.25s ease,
			color 0.25s ease;
	}

	.events-calendar-btn:hover {
		background: rgba(255, 255, 255, 0.92);
		color: #000;
	}

	.events-slides {
		position: relative;
		display: grid;
	}

	.events-slide {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.875rem;
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
		transition:
			opacity 0.4s ease,
			transform 0.4s ease;
	}

	.events-slide[data-active='true'] {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}

	.events-slide-date {
		color: rgba(255, 255, 255, 0.85);
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
	}

	.events-slide-title {
		font-size: clamp(1.625rem, 7vw, 2.75rem);
		line-height: 1.05;
		color: #fff;
		text-wrap: balance;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.55);
	}

	.events-slide-text {
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.92);
		max-width: 44ch;
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
		/* Long summaries stay a fixed block so the panel doesn't grow past the
		   viewport on a phone. */
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		overflow: hidden;
	}

	.events-slide-cta {
		margin-top: 0.375rem;
	}

	/* Mobile keeps the controls in flow under the slide — side arrows would sit
	   on top of the title at this width. */
	.events-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		margin-top: 1.75rem;
	}

	.events-arrow {
		width: 40px;
		height: 40px;
		flex-shrink: 0;
		border-radius: 999px;
		display: grid;
		place-items: center;
		background: rgba(255, 255, 255, 0.18);
		border: 1px solid rgba(255, 255, 255, 0.35);
		color: #fff;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			transform 0.2s ease;
		z-index: 3;
	}

	.events-arrow:hover {
		background: rgba(255, 255, 255, 0.32);
	}

	.events-dots {
		display: flex;
		gap: 0.5rem;
		z-index: 3;
	}

	.events-dot {
		width: 28px;
		height: 4px;
		border-radius: 999px;
		border: 0;
		background: rgba(255, 255, 255, 0.4);
		cursor: pointer;
		padding: 0;
		transition: background-color 0.2s ease;
	}

	.events-dot[data-active='true'] {
		background: #fff;
	}

	@media (min-width: 768px) {
		.events-bg-overlay {
			background:
				linear-gradient(
					to right,
					rgba(0, 0, 0, 0.75) 0%,
					rgba(0, 0, 0, 0.58) 45%,
					rgba(0, 0, 0, 0.22) 78%,
					rgba(0, 0, 0, 0) 100%
				),
				linear-gradient(to top, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0) 45%);
		}

		.events-slide {
			gap: 1.25rem;
			max-width: 56rem;
		}

		.events-slide-title {
			font-size: clamp(2.5rem, 4.4vw, 4rem);
			max-width: 22ch;
		}

		.events-slide-text {
			-webkit-line-clamp: 4;
			line-clamp: 4;
			max-width: 46ch;
		}

		/* The wrapper steps out of the layout so the arrows can flank the panel
		   and the dots sit on its bottom edge. */
		.events-controls {
			display: contents;
		}

		.events-arrow {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			width: 44px;
			height: 44px;
		}

		.events-arrow-prev {
			left: 1.5rem;
		}

		.events-arrow-next {
			right: 1.5rem;
		}

		.events-dots {
			position: absolute;
			bottom: 1.5rem;
			left: 50%;
			transform: translateX(-50%);
		}
	}

	.events-empty {
		text-align: center;
		max-width: 46ch;
		margin-inline: auto;
	}

	.events-archive-cta {
		display: flex;
		justify-content: center;
		margin-top: 2.5rem;
	}
</style>

<script>
	function initCarousels() {
		const carousels = document.querySelectorAll<HTMLElement>(
			'[data-events-carousel]',
		);

		for (const carousel of carousels) {
			if (carousel.dataset.eventsCarouselReady === 'true') continue;
			carousel.dataset.eventsCarouselReady = 'true';

			const slides = Array.from(
				carousel.querySelectorAll<HTMLElement>('[data-slide-index]'),
			);
			const dots = Array.from(
				carousel.querySelectorAll<HTMLButtonElement>('[data-events-dot]'),
			);
			const prev = carousel.querySelector<HTMLButtonElement>(
				'[data-events-prev]',
			);
			const next = carousel.querySelector<HTMLButtonElement>(
				'[data-events-next]',
			);

			if (slides.length <= 1) continue;

			let current = 0;

			function show(index: number) {
				current = (index + slides.length) % slides.length;
				slides.forEach((slide, i) => {
					const isActive = i === current;
					slide.dataset.active = isActive ? 'true' : 'false';
					slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
				});
				dots.forEach((dot, i) => {
					const isActive = i === current;
					dot.dataset.active = isActive ? 'true' : 'false';
					dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
				});
			}

			prev?.addEventListener('click', () => show(current - 1));
			next?.addEventListener('click', () => show(current + 1));
			dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

			// Swipe between events — the mobile controls sit below the panel, so
			// dragging the slide itself is the gesture people reach for first.
			let startX = 0;
			let startY = 0;

			carousel.addEventListener(
				'touchstart',
				(event) => {
					const touch = event.changedTouches[0];
					startX = touch.clientX;
					startY = touch.clientY;
				},
				{ passive: true },
			);

			carousel.addEventListener(
				'touchend',
				(event) => {
					const touch = event.changedTouches[0];
					const dx = touch.clientX - startX;
					const dy = touch.clientY - startY;
					// Ignore vertical scrolls and incidental taps.
					if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy)) return;
					show(dx < 0 ? current + 1 : current - 1);
				},
				{ passive: true },
			);
		}
	}

	initCarousels();
	document.addEventListener('astro:page-load', initCarousels);
</script>
