---
import { formatEventDate } from '../lib/events';
import { urlFor } from '../sanity/lib/image';

interface Props {
	title: string;
	slug: string;
	date: string;
	image: { asset: { _ref: string }; alt?: string };
	/** Dims the card so finished events read as secondary at a glance. */
	past?: boolean;
	/** Cards above the fold skip lazy loading. */
	eager?: boolean;
}

const { title, slug, date, image, past = false, eager = false } = Astro.props;
---

<a
	href={`/evenimente/${slug}`}
	class="group relative block aspect-square overflow-hidden text-white no-underline isolate"
	data-past={past ? 'true' : 'false'}
>
	<img
		src={urlFor(image).width(640).height(640).fit('crop').auto('format').url()}
		alt={image.alt || ''}
		loading={eager ? 'eager' : 'lazy'}
		decoding="async"
		width="640"
		height="640"
		class="event-card-img absolute inset-0 block h-full w-full object-cover transition-[transform,filter,opacity] duration-500 group-hover:scale-[1.04] group-focus-visible:scale-[1.04]"
	/>
	<div
		class="absolute inset-0 z-1 [background:linear-gradient(to_bottom,rgba(0,0,0,0.1)_0%,rgba(0,0,0,0.25)_45%,rgba(0,0,0,0.72)_100%)]"
		aria-hidden="true"
	/>

	<span
		class="absolute top-3 left-3 z-2 bg-black/55 px-2.5 py-1.5 text-[0.6875rem] font-medium tracking-[0.08em] uppercase backdrop-blur-[2px] md:top-4 md:left-4"
	>
		{formatEventDate(date)}
	</span>

	<h3
		class="display absolute right-3 bottom-3 left-3 z-2 text-[clamp(1rem,1.6vw,1.375rem)] leading-tight font-semibold md:right-4 md:bottom-4 md:left-4"
		transition:name={`event-title-${slug}`}
	>
		{title}
	</h3>
</a>

<style>
	/* Past events read as archive material rather than something to attend.
	   The treatment lifts on hover so the image is still browsable. */
	[data-past='true'] .event-card-img {
		opacity: 0.7;
		filter: grayscale(0.35);
	}

	[data-past='true']:hover .event-card-img,
	[data-past='true']:focus-visible .event-card-img {
		opacity: 1;
		filter: grayscale(0);
	}
</style>
